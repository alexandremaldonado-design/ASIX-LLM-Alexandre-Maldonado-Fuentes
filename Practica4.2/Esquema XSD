<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Element arrel -->
    <xs:element name="cataleg">
        <xs:complexType>
            <xs:sequence>
                <xs:choice maxOccurs="unbounded">
                    <xs:element ref="single"/>
                    <xs:element ref="album"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Element single -->
    <xs:element name="single">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="titol" type="xs:string"/>
                <xs:sequence minOccurs="0">
                    <xs:element name="descripcio" type="xs:string"/>
                </xs:sequence>
                <xs:element name="pais" type="xs:string"/>
                <xs:element name="idioma" type="xs:string"/>
                <xs:element name="genere" type="tipusGenere" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="grup" type="xs:string"/>
                <xs:element ref="membres"/>
                <xs:element name="durada" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="codi" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- Element album -->
    <xs:element name="album">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="titol" type="xs:string"/>
                <xs:sequence minOccurs="0">
                    <xs:element name="descripcio" type="xs:string"/>
                </xs:sequence>
                <xs:element name="pais" type="xs:string"/>
                <xs:element name="idioma" type="xs:string"/>
                <xs:element name="genere" type="tipusGenere" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element name="grup" type="xs:string"/>
                <xs:element ref="membres"/>
                <xs:element name="numero_cancons" type="xs:string"/>
                <xs:element ref="cancons"/>
            </xs:sequence>
            <xs:attribute name="codi" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- Element membres -->
    <xs:element name="membres">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="membre" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="nom" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="sexe" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="home"/>
                                    <xs:enumeration value="dona"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Element cancons -->
    <xs:element name="cancons">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="canco" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="titol_canco" type="xs:string"/>
                            <xs:element name="durada_canco" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="numero" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Tipus enumerat per al gènere -->
    <xs:simpleType name="tipusGenere">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Música clásica"/>
            <xs:enumeration value="Jazz"/>
            <xs:enumeration value="Blues"/>
            <xs:enumeration value="Góspel"/>
            <xs:enumeration value="Soul"/>
            <xs:enumeration value="Pop"/>
            <xs:enumeration value="Rock and Roll"/>
            <xs:enumeration value="Country"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>