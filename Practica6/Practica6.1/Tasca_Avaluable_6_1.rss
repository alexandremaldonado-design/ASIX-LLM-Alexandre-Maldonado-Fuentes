<?xml version="1.0" encoding="utf-8"?>
<!--
    DECLARACIÓ XML:
    - version="1.0" -> Versió d'XML utilitzada (l'estàndard)
    - encoding="utf-8" -> Codificació de caràcters que permet accents, ñ, etc.
-->

<rss version="2.0">
    <!--
        rss: Element arrel del document RSS
        version="2.0": Indica que estem fent servir la versió 2.0 de RSS
    -->

    <channel>
        <!--
            channel: Conté la informació del canal i les notícies
            És obligatori dins de <rss>
        -->

        <!-- title: Títol del canal de notícies -->
        <title>Notícies sobre cotxes</title>

        <!-- description: Descripció breu del contingut del canal -->
        <description>Últimes notícies sobre el món del motor</description>

        <!--
            link: URL del lloc web associat al canal
            On els usuaris poden trobar més informació
        -->
        <link>https://www.motornews.com/</link>

        <!--
            language: Idiome en què està escrit el contingut
            "ca" = Català (codi ISO 639-1)
        -->
        <language>ca</language>

        <!--
            pubDate: Data i hora de publicació del canal
            Format RFC 822: Dia, DD Mes YYYY hh:mm:ss ±hhmm
            - Fri = Friday (divendres)
            - +0100 = fus horari (Espanya hivern = UTC+1)
        -->
        <pubDate>Fri, 15 Nov 2024 12:00:00 +0100</pubDate>

        <!-- ========== PRIMERA NOTÍCIA (ITEM) ========== -->
        <item>
            <!--
                item: Cada notícia individual del canal
                Equivalent a <entry> a Atom
            -->

            <!-- title: Títol de la notícia -->
            <title>Ferrari presenta el seu nou model híbrid, el SF-2024</title>

            <!--
                description: Cos o resum de la notícia
                Pot contenir text pla o HTML (amb les escapes adequades)
            -->
            <description>Ferrari ha anunciat el llançament del seu nou model híbrid, el SF-2024, que combina rendiment i sostenibilitat. Amb un motor V8 de 800 CV i un sistema elèctric de suport, és el cotxe més avançat de la marca fins ara. La seva autonomia en mode elèctric arriba als 50 km.</description>

            <!--
                link: Enllaç a la notícia completa al web original
                L'usuari pot fer clic per llegir-ne més
            -->
            <link>https://www.motornews.com/ferrari-sf-2024-hibrid</link>

            <!--
                guid: Global Unique Identifier
                Identificador únic per a aquesta notícia
                Normalment s'utilitza el mateix link (com aquí)
            -->
            <guid>https://www.motornews.com/ferrari-sf-2024-hibrid</guid>

            <!--
                pubDate: Data de publicació de la notícia
                Format RFC 822 igual que al canal
                Thu = Thursday (dijous)
            -->
            <pubDate>Thu, 14 Nov 2024 10:00:00 +0100</pubDate>
        </item>

        <!-- ========== SEGONA NOTÍCIA (ITEM) ========== -->
        <item>
            <title>Volkswagen anuncia una inversió de 10.000 milions en vehicles elèctrics</title>
            <description>La companyia Volkswagen ha anunciat una inversió massiva en el desenvolupament de vehicles elèctrics. El pla preveu la creació de tres nous models elèctrics per al 2025, amb una autonomia de fins a 700 km i tecnologies de conducció autònoma.</description>
            <link>https://www.motornews.com/volkswagen-investment-electric-cars</link>
            <guid>https://www.motornews.com/volkswagen-investment-electric-cars</guid>
            <!--
                Tue = Tuesday (dimarts)
                +0100 = fus horari d'hivern a Espanya
            -->
            <pubDate>Tue, 12 Nov 2024 15:30:00 +0100</pubDate>
        </item>

    </channel>
    <!-- FI DEL CHANNEL -->

</rss>
<!-- FI DEL DOCUMENT RSS -->
