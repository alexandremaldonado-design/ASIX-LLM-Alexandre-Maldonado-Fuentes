<!ELEMENT cifp (alumne|professor)*>

<!ELEMENT alumne (nom, llinatges, data_naixement?, correu?, telefon?, adreça?, data_matricula, curs)>
<!ATTLIST alumne
    id ID #REQUIRED
>

<!ELEMENT professor (nom, llinatges, data_naixement?, correu?, telefon?, adreça?, data_incorporacio, departament, assignatura*)>
<!ATTLIST professor
    id ID #REQUIRED
>

<!ELEMENT nom (#PCDATA)>
<!ELEMENT llinatges (#PCDATA)>
<!ELEMENT data_naixement (#PCDATA)>
<!ELEMENT correu (#PCDATA)>
<!ELEMENT telefon (#PCDATA)>
<!ELEMENT adreça (#PCDATA)>

<!ELEMENT data_matricula (#PCDATA)>
<!ELEMENT curs (#PCDATA)>

<!ELEMENT data_incorporacio (#PCDATA)>
<!ELEMENT departament (#PCDATA)>

<!ELEMENT assignatura (nom_assignatura)>
<!ATTLIST assignatura
    id_assignatura ID #REQUIRED
>

<!ELEMENT nom_assignatura (#PCDATA)>
<!ATTLIST nom_assignatura
    cicle (DAM | DAW | ASIX | SMX | SEIA | ER | AUT) #REQUIRED
    data_inici CDATA #IMPLIED
    data_final CDATA #IMPLIED
>
